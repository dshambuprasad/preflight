{
  "name": "@preflight/api-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated from apps/api Zod schemas via OpenAPI (16 §2.6). The only contract apps/web compiles against.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen": "openapi-typescript src/openapi.json -o src/openapi.d.ts --alphabetize --root-types",
    "build": "tsc -b && cp src/openapi.d.ts dist/src/openapi.d.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "@types/node": "22.20.2"
  }
}
