# 15 §4 — copy to .env for local development (apps/api reads process.env; docker compose reads this file's vars).
NODE_ENV=development
PREFLIGHT_ROLE=all
PORT=3000
DATABASE_URL=postgres://preflight:preflight@localhost:5432/preflight
DATABASE_POOL_MAX=10
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PREFLIGHT_KMS_KEY=
# ≥ 32 chars
PREFLIGHT_SESSION_SECRET=
PREFLIGHT_SESSION_TTL_HOURS=12
PREFLIGHT_STORAGE=postgres
PREFLIGHT_DEMO_MOCK_CONNECTORS=false
PREFLIGHT_RULEBOOK_DIR=./rulebook
PREFLIGHT_JOB_CONCURRENCY=4
PREFLIGHT_RATE_LIMIT_PER_MIN=100
PREFLIGHT_INLINE_ROWS_MAX=5000
PREFLIGHT_LLM_PROVIDER=null
LOG_LEVEL=info
PREFLIGHT_PUBLIC_URL=http://localhost:5173
PREFLIGHT_WEB_ORIGIN=http://localhost:5173
# printed by `pnpm seed` when unset
PREFLIGHT_SEED_PASSWORD=
VITE_API_BASE=/v1
