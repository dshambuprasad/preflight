{
  "name": "@preflight/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preflight REST API + pipeline orchestration (02 §3, 05, 06).",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./pipeline": {
      "types": "./dist/src/pipeline/index.d.ts",
      "import": "./dist/src/pipeline/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "seed": "node dist/src/seed.js",
    "gen:openapi": "node dist/src/gen-openapi.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@preflight/core": "workspace:*",
    "@preflight/db": "workspace:*",
    "@preflight/rulegraph": "workspace:*",
    "@preflight/rules-india": "workspace:*",
    "argon2": "0.45.1",
    "fastify": "5.12.4",
    "fastify-type-provider-zod": "6.1.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "uuid": "14.0.2",
    "zod": "4.6.2",
    "fastify-plugin": "6.0.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
