{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "bench": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "CI",
    "PREFLIGHT_*",
    "NODE_ENV",
    "LOG_LEVEL"
  ]
}
